	column Quantidade
		dataType: int64
		formatString: 0
		lineageTag: f1497dee-6123-4c81-8768-103ced3e0a10
		summarizeBy: sum
		sourceColumn: Quantidade

		annotation SummarizationSetBy = Automatic

	column Valor_unitario = ```
			RELATED(Produtos[Valor]) 
			```
		formatString: "R$"\ #,0.###############;-"R$"\ #,0.###############;"R$"\ #,0.###############
		lineageTag: 1498bef4-ac68-4faa-844a-359148357c66
