table Vendas
	lineageTag: 0113aada-12f0-471a-9e76-7ba64196d1a1

	measure 'Faturamento total' = SUM('Vendas'[Faturamento])
		formatString: "R$"\ #,0.###############;-"R$"\ #,0.###############;"R$"\ #,0.###############
		lineageTag: e8521147-f875-4b45-9974-483d14076fd6

