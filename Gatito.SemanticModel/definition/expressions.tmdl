expression 'Transformar o Arquivo de Exemplo' =
		let
		    Fonte = Excel.Workbook(Parâmetro1, null, true),
		    Vendas_Table = Fonte{[Item="Vendas",Kind="Table"]}[Data]
		in
		    Vendas_Table
	lineageTag: 944bd441-287f-4425-8d84-9bc28183003e
	queryGroup: 'Transformar Arquivo de Vendas'

	annotation PBI_ResultType = Table

expression 'Arquivo de Amostra' =
		let
		    Fonte = Folder.Files("C:\Users\kaikg\Downloads\Alura\PowerBI-PrimeiroDashboard-Aula1-Material\base\Vendas"),
		    Navegação1 = Fonte{0}[Content]
